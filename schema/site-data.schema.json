{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Website data API, version 1. Generated by `figurelib.py site`; read by site/assets/js. Public mode must never carry validation details or reference/comparison media.",
  "type": "object",
  "properties": {
    "api_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "public",
        "local"
      ]
    },
    "generator": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "repository": {
          "type": "object"
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "title",
        "subtitle",
        "repository",
        "features"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "collected",
              "example"
            ]
          },
          "status": {
            "enum": [
              "captured",
              "draft",
              "reproduced",
              "reusable"
            ]
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created": {
            "type": "string"
          },
          "why_saved": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "unknown",
                  "original",
                  "digitized",
                  "synthetic"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "notes"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "unknown",
                  "self",
                  "paper",
                  "web",
                  "example"
                ]
              },
              "citation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "figure_label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "citation",
              "doi",
              "url",
              "figure_label"
            ],
            "additionalProperties": false
          },
          "reuse": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "caveats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "scope",
              "caveats"
            ],
            "additionalProperties": false
          },
          "implementation": {
            "type": "object",
            "properties": {
              "language": {
                "enum": [
                  "python",
                  "r",
                  "other",
                  null
                ]
              }
            },
            "required": [
              "language"
            ],
            "additionalProperties": false
          },
          "style": {
            "type": [
              "object",
              "null"
            ]
          },
          "contract": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "description",
                  "columns",
                  "constraints"
                ],
                "additionalProperties": false
              }
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "known_differences": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "summary": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "summary"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "provenance": {
                    "type": "array"
                  },
                  "reviewer": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "flags": {
                    "type": "object"
                  }
                },
                "required": [
                  "summary",
                  "known_differences",
                  "checks"
                ],
                "additionalProperties": false
              }
            ]
          },
          "media": {
            "type": "object",
            "properties": {
              "thumbnail": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^media/[a-z0-9][a-z0-9-]{2,63}/[a-z]+\\.(png|svg)$"
              },
              "preview": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^media/[a-z0-9][a-z0-9-]{2,63}/[a-z]+\\.(png|svg)$"
              },
              "vector": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^media/[a-z0-9][a-z0-9-]{2,63}/[a-z]+\\.(png|svg)$"
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^media/[a-z0-9][a-z0-9-]{2,63}/[a-z]+\\.(png|svg)$"
              },
              "comparison": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^media/[a-z0-9][a-z0-9-]{2,63}/[a-z]+\\.(png|svg)$"
              },
              "thumbnail_is_reference": {
                "type": "boolean"
              }
            },
            "required": [
              "thumbnail",
              "preview",
              "vector",
              "reference",
              "comparison",
              "thumbnail_is_reference"
            ],
            "additionalProperties": false
          },
          "path": {
            "type": "string",
            "pattern": "^(figures|examples)/[a-z0-9][a-z0-9-]{2,63}$"
          },
          "links": {
            "type": "object",
            "properties": {
              "entry": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "path",
                    "url"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "entry",
              "files"
            ],
            "additionalProperties": false
          },
          "validation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ok",
                  "errors",
                  "notes"
                ],
                "additionalProperties": false
              }
            ]
          },
          "publication": {
            "type": "object",
            "properties": {
              "rights_note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "rights_note"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "status",
          "family",
          "tags",
          "created",
          "why_saved",
          "data",
          "source",
          "reuse",
          "implementation",
          "style",
          "contract",
          "review",
          "media",
          "path",
          "links",
          "validation"
        ],
        "additionalProperties": false
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "errors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "api_version",
    "mode",
    "generator",
    "site",
    "entries",
    "problems"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "public"
          }
        }
      },
      "then": {
        "properties": {
          "problems": {
            "maxItems": 0
          },
          "entries": {
            "items": {
              "properties": {
                "validation": {
                  "type": "null"
                },
                "media": {
                  "properties": {
                    "reference": {
                      "type": "null"
                    },
                    "comparison": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

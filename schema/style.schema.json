{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual executable plotting settings, extensible per chart.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "figure": {
      "type": "object",
      "properties": {
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 2400
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        }
      },
      "required": [
        "width_mm",
        "height_mm",
        "dpi",
        "background"
      ],
      "additionalProperties": true
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "family": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "base_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "family",
        "base_size_pt"
      ],
      "additionalProperties": true
    },
    "layout": {
      "type": "object"
    },
    "marks": {
      "type": "object"
    },
    "axes": {
      "type": "object"
    },
    "legend": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "figure",
    "palette",
    "typography",
    "layout",
    "marks",
    "axes",
    "legend"
  ],
  "additionalProperties": true
}

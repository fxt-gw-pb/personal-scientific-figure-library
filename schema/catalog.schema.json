{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stable private catalog API, version 1; not the public-export whitelist.",
  "type": "object",
  "properties": {
    "api_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "collected",
              "example"
            ]
          },
          "status": {
            "enum": [
              "captured",
              "draft",
              "reproduced",
              "reusable"
            ]
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "why_saved": {
            "type": "string"
          },
          "data_kind": {
            "enum": [
              "unknown",
              "original",
              "digitized",
              "synthetic"
            ]
          },
          "palette": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            }
          },
          "paths": {
            "type": "object",
            "properties": {
              "entry": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "metadata": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "readme": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "style": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "contract": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "preview": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "thumbnail": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "vector": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "comparison": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "required": [
              "entry",
              "metadata",
              "readme",
              "style",
              "contract",
              "preview",
              "thumbnail",
              "vector",
              "reference",
              "comparison"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "status",
          "family",
          "tags",
          "why_saved",
          "data_kind",
          "palette",
          "paths"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "api_version",
    "entries"
  ],
  "additionalProperties": false
}
